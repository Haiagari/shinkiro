{# partials/attack_paths.j2 - Attack Path Visualization Section #}

{% if attack_paths and attack_paths|length > 0 %}
    <div class="section-header">Attack Paths</div>

    <div style="margin-bottom: 40px;">
        <p style="color: var(--secondary); font-size: 14px; margin-bottom: 25px;">
            Potential attack vectors identified by the LogicAnalyzer based on discovered findings.
            Each path represents a sequence of steps an attacker might take.
        </p>

        {% for path in attack_paths %}
            <div class="attack-path" style="margin-bottom: 30px; padding: 20px; background: #f7fafc; border-radius: 8px;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px;">
                    <h3 style="margin: 0; color: var(--primary);">
                        Path {{ loop.index }}: {{ path.path_id if path.path_id else 'Unnamed' }}
                    </h3>
                    {% if path.risk_score %}
                        <span style="font-weight: bold;">
                            {{ macros.risk_score_badge(path.risk_score) }}
                        </span>
                    {% endif %}
                </div>

                {% if path.description %}
                    <p style="font-size: 14px; color: var(--text-color); margin-bottom: 15px;">
                        {{ path.description }}
                    </p>
                {% endif %}

                {% if path.steps and path.steps|length > 0 %}
                    <div style="background: white; padding: 15px; border-radius: 6px; border: 1px solid var(--border);">
                        <h4 style="font-size: 13px; color: var(--secondary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">
                            Attack Steps
                        </h4>
                        <ol style="margin-left: 20px; font-size: 13px; line-height: 1.8;">
                            {% for step in path.steps %}
                                <li style="margin-bottom: 8px;">{{ step }}</li>
                            {% endfor %}
                        </ol>
                    </div>
                {% endif %}

                {% if path.prerequisites and path.prerequisites|length > 0 %}
                    <div style="margin-top: 15px; padding: 10px; background: #fffbeb; border-left: 3px solid var(--warning); border-radius: 4px;">
                        <h4 style="font-size: 12px; color: var(--warning); margin-bottom: 8px; text-transform: uppercase;">
                            Prerequisites
                        </h4>
                        <ul style="margin-left: 20px; font-size: 12px; color: var(--text-color);">
                            {% for prereq in path.prerequisites %}
                                <li style="margin-bottom: 4px;">{{ prereq }}</li>
                            {% endfor %}
                        </ul>
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>

{% else %}
    <div class="section-header">Attack Paths</div>
    <div style="padding: 30px; text-align: center; background: #f7fafc; border-radius: 8px; color: var(--secondary);">
        <p style="font-size: 16px; margin-bottom: 10px;">No attack paths identified</p>
        <p style="font-size: 13px;">The LogicAnalyzer did not identify any attack vectors for this scan.</p>
    </div>
{% endif %}
