{# partials/charts.j2 - Charts Section with Chart.js and Static Fallback #}

{% if charts and charts|length > 0 %}
    <div class="section-header">Vulnerability Analytics</div>

    <div class="stats-grid" style="margin-bottom: 60px;">
        {% for chart_name, chart_config in charts.items() %}
            {% if chart_config %}
                <div class="chart-box">
                    <h3 style="font-size: 14px; color: var(--secondary); margin-bottom: 15px; text-align: center;">
                        {{ chart_name|replace('_', ' ')|title }}
                    </h3>

                    {# Chart.js Canvas - visible when JS is enabled #}
                    <div style="position: relative; height: 300px;">
                        <canvas id="{{ chart_name }}"></canvas>
                    </div>

                    {# Static Fallback - visible in print/PDF where JS doesn't run #}
                    <div class="chart-fallback" style="margin-top: 15px;">
                        <p style="font-size: 12px; margin-bottom: 10px;">
                            Static representation (for PDF/print):
                        </p>

                        {% if chart_config.chart_type == 'doughnut' or chart_config.chart_type == 'pie' %}
                            {# Pie/Doughnut fallback - simple list #}
                            <div style="text-align: left; display: inline-block;">
                                {% for label, dataset in zip(chart_config.labels, chart_config.datasets[0].data) %}
                                    <div style="margin-bottom: 5px; font-size: 12px;">
                                        <span style="display: inline-block; width: 12px; height: 12px;
                                              background: {{ chart_config.datasets[0].backgroundColor[loop.index0] if chart_config.datasets[0].backgroundColor is iterable and chart_config.datasets[0].backgroundColor[loop.index0] else '#ccc' }};
                                              margin-right: 8px; vertical-align: middle;"></span>
                                        {{ label }}: <strong>{{ dataset }}</strong>
                                    </div>
                                {% endfor %}
                            </div>
                        {% elif chart_config.chart_type == 'bar' %}
                            {# Bar chart fallback - simple horizontal bars #}
                            {% set max_value = chart_config.datasets[0].data|max if chart_config.datasets[0].data else 1 %}
                            <div style="text-align: left;">
                                {% for label, value in zip(chart_config.labels, chart_config.datasets[0].data) %}
                                    <div style="margin-bottom: 8px; font-size: 12px;">
                                        <div style="display: flex; justify-content: space-between; margin-bottom: 2px;">
                                            <span>{{ label }}</span>
                                            <span><strong>{{ value }}</strong></span>
                                        </div>
                                        <div style="background: #e2e8f0; height: 16px; border-radius: 3px; overflow: hidden;">
                                            <div style="background: {{ chart_config.datasets[0].backgroundColor if chart_config.datasets[0].backgroundColor else 'var(--accent)' }};
                                                    width: {{ (value / max_value * 100) if max_value > 0 else 0 }}%;
                                                    height: 100%;"></div>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p style="font-style: italic; color: var(--secondary);">
                                Chart data: {{ chart_config.labels|length }} categories
                            </p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>

{% else %}
    {# Show default charts if no custom charts provided but we have findings #}
    {% if summary and summary.total_findings > 0 %}
        <div class="section-header">Vulnerability Distribution</div>

        <div class="stats-grid" style="margin-bottom: 60px;">
            {# Severity Doughnut Chart #}
            <div class="chart-box">
                <h3 style="font-size: 14px; color: var(--secondary); margin-bottom: 15px; text-align: center;">
                    Findings by Severity
                </h3>
                <div style="position: relative; height: 300px;">
                    <canvas id="severityChart"></canvas>
                </div>
                <div class="chart-fallback" style="margin-top: 15px;">
                    <div style="text-align: left; display: inline-block; font-size: 12px;">
                        <div style="margin-bottom: 5px;">
                            <span style="display: inline-block; width: 12px; height: 12px; background: #dc2626; margin-right: 8px;"></span>
                            Critical: <strong>{{ summary.critical_count if summary.critical_count else 0 }}</strong>
                        </div>
                        <div style="margin-bottom: 5px;">
                            <span style="display: inline-block; width: 12px; height: 12px; background: #ea580c; margin-right: 8px;"></span>
                            High: <strong>{{ summary.high_count if summary.high_count else 0 }}</strong>
                        </div>
                        <div style="margin-bottom: 5px;">
                            <span style="display: inline-block; width: 12px; height: 12px; background: #d97706; margin-right: 8px;"></span>
                            Medium: <strong>{{ summary.medium_count if summary.medium_count else 0 }}</strong>
                        </div>
                        <div style="margin-bottom: 5px;">
                            <span style="display: inline-block; width: 12px; height: 12px; background: #2563eb; margin-right: 8px;"></span>
                            Low: <strong>{{ summary.low_count if summary.low_count else 0 }}</strong>
                        </div>
                    </div>
                </div>
            </div>

            {# Summary text #}
            <div style="display: flex; flex-direction: column; justify-content: center;">
                <p style="font-size: 14px; color: var(--secondary); line-height: 1.8;">
                    This report identified <strong>{{ summary.total_findings }}</strong> security findings.
                    {% if summary.critical_count > 0 %}
                        <span style="color: var(--critical);">Critical issues require immediate attention.</span>
                    {% elif summary.high_count > 0 %}
                        <span style="color: var(--high);">High severity issues should be prioritized.</span>
                    {% else %}
                        No critical or high severity issues were found.
                    {% endif %}
                </p>
            </div>
        </div>
    {% endif %}
{% endif %}
