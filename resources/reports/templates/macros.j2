{# macros.j2 - Reusable Jinja2 macros for OzyRecon reports #}

{% macro severity_badge(severity) %}
    <span class="severity-badge severity-{{ severity|lower }}">
        {{ severity|upper }}
    </span>
{% endmacro %}

{% macro severity_color(severity) %}
    {% if severity|lower == 'critical' %}
        #e53e3e
    {% elif severity|lower == 'high' %}
        #dd6b20
    {% elif severity|lower == 'medium' %}
        #d69e2e
    {% elif severity|lower == 'low' %}
        #38a169
    {% else %}
        #64748b
    {% endif %}
{% endmacro %}

{% macro risk_score_badge(score) %}
    {% if score >= 80 %}
        <span class="severity-badge severity-critical">{{ "%.1f"|format(score) }}</span>
    {% elif score >= 60 %}
        <span class="severity-badge severity-high">{{ "%.1f"|format(score) }}</span>
    {% elif score >= 40 %}
        <span class="severity-badge severity-medium">{{ "%.1f"|format(score) }}</span>
    {% else %}
        <span class="severity-badge severity-low">{{ "%.1f"|format(score) }}</span>
    {% endif %}
{% endmacro %}

{% macro format_date(date_string) %}
    {% if date_string %}
        {{ date_string }}
    {% else %}
        N/A
    {% endif %}
{% endmacro %}

{% macro finding_row(finding, index) %}
    <tr class="finding-row">
        <td>{{ index }}</td>
        <td>{{ finding.title }}</td>
        <td>{{ severity_badge(finding.severity) }}</td>
        <td>{{ finding.description|truncate(100) }}</td>
        <td>
            {% if finding.evidence %}
                <details>
                    <summary>View Evidence</summary>
                    <pre><code>{{ finding.evidence }}</code></pre>
                </details>
            {% else %}
                N/A
            {% endif %}
        </td>
        <td>
            {% if finding.remediation %}
                <details>
                    <summary>View Remediation</summary>
                    <p>{{ finding.remediation }}</p>
                </details>
            {% else %}
                N/A
            {% endif %}
        </td>
        <td>
            {% if finding.cvss_score %}
                {{ "%.1f"|format(finding.cvss_score) }}
            {% else %}
                N/A
            {% endif %}
        </td>
    </tr>
{% endmacro %}

{% macro progress_bar(value, max_value=100, color=None) %}
    {% set percentage = (value / max_value * 100) if max_value > 0 else 0 %}
    {% set bar_color = color if color else severity_color('medium') %}
    <div class="progress-bar-container">
        <div class="progress-bar" style="width: {{ percentage }}%; background-color: {{ bar_color }};">
            {{ "%.1f"|format(percentage) }}%
        </div>
    </div>
{% endmacro %}
