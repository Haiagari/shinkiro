# API Configuration
# -----------------
OZY_API_PORT=8000
OZY_DEBUG=false

# External Intelligence Keys
# --------------------------
# Get yours at: https://shodan.io
SHODAN_API_KEY=your_key_here

# Get yours at: https://hunter.io
HUNTER_IO_KEY=your_key_here

# Get yours at: https://censys.io
CENSYS_ID=your_id_here
CENSYS_SECRET=your_secret_here

# Storage & Evidence
# ------------------
OZY_DB_PATH=./data/ozyrecon.db
OZY_EVIDENCE_PATH=./evidence/
OZY_SIGNING_KEY=generate_a_strong_secret_here

# OPSEC & Safety
# --------------
# Comma-separated domains to NEVER scan
OZY_EXCLUDE_DOMAINS=gov,mil,edu
OZY_AUTO_APPROVE_LOW_RISK=false
